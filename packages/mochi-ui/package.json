{
  "name": "@melodicbloom/mochi-ui",
  "version": "0.1.0",
  "description": "Claymorphism React components with deterministic spring physics (Mochi UI).",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "homepage": "https://melodicbloom.github.io/mochi-ui/",
  "repository": { "type": "git", "url": "git+https://github.com/MelodicBloom/mochi-ui.git", "directory": "packages/mochi-ui" },
  "keywords": ["claymorphism", "react", "spring-physics", "design-system", "motion"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}

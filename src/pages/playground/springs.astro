---
import Layout from '../../layouts/Layout.astro';
import '../../styles/clay.css';
import SpringPlayground from '../../components/playground/SpringPlayground';
---

<Layout title="Spring Physics Playground — Mochi UI">
  <main style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;padding:48px 16px;font-family:var(--font-family, system-ui, sans-serif);">
    <header style="text-align:center;max-width:640px">
      <h1>Spring physics playground</h1>
      <p>Tune stiffness, damping and mass for <code>@melodicbloom/mochi-spring</code> and feel the clay squish. Respects <code>prefers-reduced-motion</code>.</p>
    </header>
    <SpringPlayground client:only="react" />
  </main>
</Layout>
